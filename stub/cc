#!/usr/bin/env bash
# Claude Code for this repo, in a container: run `docker/cc`, or
# `docker/cc shell`, `build` or `upgrade`. This file is the claude-container
# stub, the same in every repo. Copy it from the kit's stub/cc rather than
# edit it here: the repo's own settings go in docker/kit.toml.
#
# The image that docker/Dockerfile's FROM line names holds the launcher, in
# /opt/kit. On the first run for each tag, this copies that directory to
# ~/.cache/claude-container/<tag>, or under $XDG_CACHE_HOME when it is set,
# then runs the launcher there. So a FROM line on a fixed tag pins the image
# and the launcher together. A FROM line on the latest tag gets a copy for
# each image it pulls. The kit's README says what the launcher does.
#
# KIT_DEV, set to the path of a claude-container checkout, runs that
# checkout's launcher instead.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
base=$(sed -nE 's#^FROM[[:space:]]+(ghcr\.io/ai-progress-agent/claude-container:[^[:space:]]+).*#\1#p' "$here/Dockerfile" | head -n 1)
if [ -z "$base" ]; then
  echo "docker/cc: docker/Dockerfile has no FROM ghcr.io/ai-progress-agent/claude-container:<tag> line" >&2
  exit 1
fi
export KIT_DOCKER_DIR=$here KIT_BASE_IMAGE=$base

if [ -n "${KIT_DEV:-}" ]; then
  KIT_DEV=$(cd "$KIT_DEV" && pwd)
  export KIT_DEV
  exec "$KIT_DEV/kit/cc" "$@"
fi

tag=${base#*:}
key=${tag%%@*}
# FROM ...:latest moves, so its kit is cached by the image's ID, not the tag.
# build and upgrade pull the newest image first. Other runs use the local one,
# and pull only when the Mac has no copy yet.
if [ "$tag" = latest ]; then
  local_id=$(docker image inspect --format '{{.Id}}' "$base" 2>/dev/null) || local_id=
  if [ -z "$local_id" ] || [ "${1:-}" = build ] || [ "${1:-}" = upgrade ]; then
    if ! docker pull -q "$base" >/dev/null; then
      if [ -z "$local_id" ]; then
        echo "docker/cc: could not pull $base, and there is no local copy" >&2
        exit 1
      fi
      echo "docker/cc: could not pull $base, so this uses the local copy" >&2
    fi
  fi
  id=$(docker image inspect --format '{{.Id}}' "$base")
  id=${id#sha256:}
  key=latest-${id:0:12}
fi
kit=${XDG_CACHE_HOME:-$HOME/.cache}/claude-container/$key
if [ ! -x "$kit/cc" ]; then
  # Copy into a new directory, then rename it, so a failed copy leaves no
  # kit behind for the next run to trust. The trap cleans up after a failure
  # or a ctrl-c.
  mkdir -p "$(dirname "$kit")"
  tmp=$(mktemp -d "$kit.XXXXXX")
  id=
  trap 'rm -rf "$tmp"; [ -z "$id" ] || docker rm "$id" >/dev/null' EXIT
  id=$(docker create "$base")
  docker cp "$id:/opt/kit/." "$tmp"
  # Another run may have finished first. Its kit is the same, so keep it.
  if [ ! -x "$kit/cc" ]; then
    rm -rf "$kit"
    mv "$tmp" "$kit"
  fi
  rm -rf "$tmp"
  docker rm "$id" >/dev/null
  trap - EXIT
fi
exec "$kit/cc" "$@"

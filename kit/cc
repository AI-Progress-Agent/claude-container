#!/usr/bin/env bash
# The claude-container launcher. It runs Claude Code for a repo in a
# container that mirrors the host's Claude setup: global CLAUDE.md, settings,
# hooks, output styles, skills, plugins, the status line, git identity, and
# the project's memory. The program's other repos cloned next to the repo
# mount read-only.
#
# A repo does not call this file directly. Its docker/cc stub copies this
# kit out of the image that docker/Dockerfile's FROM line names, once per
# image tag. Then it runs that copy with KIT_DOCKER_DIR set to the repo's
# docker directory. So these are the stub's commands:
#
#   docker/cc [args]      interactive Claude; args go to claude unchanged
#   docker/cc shell       a bash prompt in the same container
#   docker/cc build       build the image; again after mise.toml changes
#   docker/cc upgrade     rebuild from scratch, so every "latest" in the
#                         repo's mise config moves
#
# The first run asks you to sign in. The host keeps its login in the macOS
# keychain, which the container cannot read, so the container keeps its own
# in a volume. Later runs skip the sign-in.
#
# Every run is a fresh container. What lasts is in volumes, and in the host
# paths it mounts.
#
# Two committed files, both optional, carry what is the repo's alone:
#
#   docker/kit.sh               sourced by this script: the repo's settings,
#                               which load_repo_config lists
#   docker/compose.repo.yaml    stacked on compose.yaml: the repo's own
#                               volumes and environment variables
#
# Two uncommitted files, both optional, carry what is yours alone:
#
#   docker/compose.local.yaml   stacked on compose.repo.yaml: your own mounts
#                               and environment variables
#   docker/cc.local             sourced by this script before the container
#                               starts: export what those variables need, and
#                               append commands to local_setup to run inside
#                               before Claude does, and redefine notify_host
#                               to use your own notifier, and name in
#                               skip_marketplaces the folder marketplaces to
#                               keep out
#
# KIT_DEV, set to the path of a claude-container checkout, tries a kit change
# on a real repo before a release. The stub runs that checkout's launcher,
# and build and upgrade build that checkout's base image first. The repo's
# image is then built on it, in place of the image the FROM line names.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# The repo's docker directory, and the repo that holds it.
docker_dir=${KIT_DOCKER_DIR:-}
repo=$(dirname "${docker_dir:-.}")

# The tag KIT_DEV builds its base image under.
dev_image=claude-container:dev

main() {
  : "${KIT_DOCKER_DIR:?run docker/cc in a repo, not the launcher itself}"
  load_repo_config
  export_compose_env
  build_compose_command

  local program=claude
  case "${1:-}" in
    build)
      shift
      build_dev_base
      exec "${compose[@]}" build "$@"
      ;;
    # A plain build reuses each cached layer, so nothing the repo's mise
    # config installs as "latest" ever moves. This skips the cache. Claude
    # and the base image's tools move only with a new base image: merge the
    # pull request that bumps the FROM line, then build.
    upgrade)
      shift
      build_dev_base
      exec "${compose[@]}" build --no-cache "$@"
      ;;
    shell)
      shift
      program=bash
      ;;
  esac

  # A run builds the image when it is missing. Under KIT_DEV, that build
  # needs the base image from the checkout.
  if [ -n "${KIT_DEV:-}" ] && ! docker image inspect "$dev_image" >/dev/null 2>&1; then
    build_dev_base
  fi

  # A bind mount whose source is missing becomes an empty directory owned by
  # root. compose.yaml mounts this one, and it may not exist yet.
  mkdir -p "$HOME/.claude/projects/$PROJECT_KEY"

  collect_host_mounts
  collect_worktree_mounts "$repo"
  collect_sibling_repos
  export_gh_token
  export_timezone
  load_local_overrides "$@"
  collect_marketplaces
  start_notify_watcher
  run_container "$program" "$@"
}

# Sets the repo's settings to the kit's defaults, then sources docker/kit.sh,
# which can change any of them:
#
#   project_name        names the compose project, and so the image and the
#                       volumes, the login among them. The main clone's
#                       directory name plus -claude, by default. Two repos
#                       with one name would share a login and an image.
#   writable_siblings   the sibling repos that mount writable. None, by
#                       default. See collect_sibling_repos.
#   start_commands      shell commands run inside at each start, before
#                       docker/cc.local's local_setup. Nothing, by default.
#   agent_browser_port  the port of the Mac's Chrome that agent-browser
#                       drives. The cdp port in the repo's agent-browser.json,
#                       by default. Empty, agent-browser drives nothing on
#                       the Mac.
#
# kit.sh is sourced inside this function, so it sets each one by plain
# assignment. A `local` or a `declare` without -g there would be lost.
load_repo_config() {
  # Compose takes lower-case letters, digits, dashes and underscores only.
  project_name=$(basename "$(main_clone)" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' -)-claude
  writable_siblings=()
  start_commands=true
  agent_browser_port=
  if [ -f "$repo/agent-browser.json" ]; then
    agent_browser_port=$(sed -nE 's/.*"cdp"[[:space:]]*:[[:space:]]*"?([0-9]+).*/\1/p' "$repo/agent-browser.json" | head -n 1)
  fi
  if [ -f "$docker_dir/kit.sh" ]; then
    # shellcheck source=/dev/null
    . "$docker_dir/kit.sh"
  fi
  if [ -f "$repo/agent-browser.json" ] && [ -z "$agent_browser_port" ]; then
    echo "docker/cc: agent-browser.json names no cdp port, so agent-browser drives nothing on the Mac" >&2
  fi
}

# Prints the main clone's path. From a worktree, that is the clone the
# worktree belongs to, wherever the worktree sits. Outside git, it is the
# repo itself.
main_clone() {
  local dir
  if dir=$(git_common_dir "$repo"); then
    dirname "$dir"
  else
    printf '%s\n' "$repo"
  fi
}

# compose.yaml reads these. The image is built for this user and home path,
# so a teammate building it gets their own.
export_compose_env() {
  export PROJECT_NAME=$project_name
  export REPO=$repo
  # Not GIT_COMMON_DIR: git reads that name, and would then send every git
  # command here to this repo.
  REPO_GIT=$(repo_git_dir)
  # Below the clone's root, git inside stops at the repo's mount and never
  # finds the clone's .git. Nothing inside needs to write it, so it mounts
  # read-only there.
  REPO_GIT_MODE=rw
  if [ -n "$(git -C "$repo" rev-parse --show-prefix 2>/dev/null)" ]; then
    REPO_GIT_MODE=ro
  fi
  export REPO_GIT REPO_GIT_MODE
  export HOST_HOME=$HOME
  HOST_USER=$(id -un)
  export HOST_USER
  # Claude names a project's directory under ~/.claude/projects after its
  # path, with every character that is not a letter or digit turned into a
  # dash.
  PROJECT_KEY=$(printf '%s' "$repo" | sed 's/[^A-Za-z0-9]/-/g')
  export PROJECT_KEY
}

# Prints the path of the git directory that holds the repo's hooks and
# config. In the main clone, that is the repo's own .git. The path keeps the
# form the repo has here, so the read-only mounts land where git inside
# looks. A linked worktree's .git is a file. That file points into the main
# clone's .git, so this prints the main clone's .git. Git prints it by its
# real path, as the worktree's .git file names it. Outside git, this prints
# the repo's .git.
repo_git_dir() {
  local dir
  if [ ! -d "$repo/.git" ] && dir=$(git_common_dir "$repo"); then
    printf '%s\n' "$dir"
  else
    printf '%s\n' "$repo/.git"
  fi
}

# Prints the absolute path of the git directory shared by $1's clone and all
# its worktrees: the main clone's .git. Git prints it by its real path. Fails
# outside git.
git_common_dir() {
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# Sets compose, the docker compose command with the kit's compose file and
# the repo's. Relative paths in the repo's files resolve against its docker
# directory, as they would if the kit's file sat there too. -p names the
# project, because a COMPOSE_PROJECT_NAME in your shell would otherwise win
# over compose.yaml's name and give two repos one login.
build_compose_command() {
  compose=(docker compose -p "$project_name" --project-directory "$docker_dir" -f "$here/compose.yaml")
  local file
  for file in compose.repo.yaml compose.local.yaml; do
    if [ -f "$docker_dir/$file" ]; then
      compose+=(-f "$docker_dir/$file")
    fi
  done
  if [ -n "${KIT_DEV:-}" ]; then
    compose+=(-f "$(write_dev_override)")
  fi
}

# Builds the base image from the KIT_DEV checkout, when KIT_DEV is set.
build_dev_base() {
  if [ -n "${KIT_DEV:-}" ]; then
    docker build -t "$dev_image" "$KIT_DEV"
  fi
}

# Writes a compose file that builds the repo's image on the KIT_DEV base, and
# prints its path. A build context named after the image in the FROM line
# takes that image's place, so the FROM line, digest and all, stays as it is.
# The stub sets KIT_BASE_IMAGE to that image.
write_dev_override() {
  local file=${XDG_CACHE_HOME:-$HOME/.cache}/claude-container/dev/$project_name.yaml
  mkdir -p "$(dirname "$file")"
  printf 'services:\n  claude:\n    build:\n      additional_contexts:\n        "%s": docker-image://%s\n' \
    "${KIT_BASE_IMAGE:?the stub sets KIT_BASE_IMAGE}" "$dev_image" >"$file"
  printf '%s\n' "$file"
}

# Sets mounts, the -v arguments for the run, and links, the shell text that
# recreates each mounted link inside.
collect_host_mounts() {
  # Host config to mirror, each read-only at its own path inside. A path this
  # machine does not have is left out, so any Claude setup runs as it is.
  # Links resolve only if their targets are mounted too: mount a dotfiles
  # repo in docker/compose.local.yaml. collect_marketplaces mounts the
  # folders that plugin marketplaces are read from.
  local optional=(
    .claude/CLAUDE.md
    .claude/settings.json
    .claude/settings.local.json
    .claude/output-styles
    .claude/skills
    .claude/agents
    .claude/commands
    .claude/hooks
    # installed_plugins.json names each plugin by its absolute host path.
    .claude/plugins
    # Where the skills CLI installs shared skills.
    .agents
    # Scripts the status line and hooks call by name. The image puts ~/bin
    # last on PATH.
    bin
    .config/ccstatusline
    .gitconfig
    .gitconfig.local
    .config/git
  )
  #
  # A file mounted on its own is pinned to the copy that existed at start. An
  # editor that saves by writing a new copy and renaming it over the old one
  # leaves the container reading the deleted original, and Claude drops every
  # setting in it without a word. Nothing fixes that for a plain file in
  # $HOME. A file that is a link, into a dotfiles repo say, can be fixed:
  # mount the directory its target is in, which follows the rename, and
  # recreate the link inside, pointing there. Those directories mount under
  # /mnt/host-links, not at their own paths, so they never collide with a
  # mount in compose.local.yaml.
  mounts=()
  links=
  local link_dirs=()
  local path src target parent dir d i
  for path in "${optional[@]}"; do
    src=$HOME/$path
    [ -e "$src" ] || continue
    if [ -L "$src" ] && [ -f "$src" ]; then
      target=$(realpath "$src")
      parent=$(dirname "$target")
      dir=
      i=0
      for d in ${link_dirs[@]+"${link_dirs[@]}"}; do
        [ "$d" = "$parent" ] && dir=/mnt/host-links/$i
        i=$((i + 1))
      done
      if [ -z "$dir" ]; then
        dir=/mnt/host-links/$i
        link_dirs+=("$parent")
        mounts+=(-v "$parent:$dir:ro")
      fi
      links+=$(printf 'ln -sfn %q %q && ' "$dir/$(basename "$target")" "$src")
    else
      mounts+=(-v "$src:$src:ro")
    fi
  done
}

# Adds to mounts, read-only, the files that lead each worktree's git to the
# hooks and config. $1 is a directory in a clone, by the path the container
# sees it at. A linked worktree's .git file names its git directory, under
# worktrees/ in the main clone's .git. That directory's commondir file names
# the main clone's .git. Both sit in writable mounts otherwise. The container
# could then point git on the Mac at a config of its own, and so get past the
# read-only mounts of hooks and config. This covers every worktree of the
# clone, not only the one docker/cc runs from.
#
# Each worktree's .git file mounts even where the worktree does not. Git
# inside would otherwise take a worktree it cannot see for a deleted one, and
# git worktree prune, or git gc, would remove its git directory from the
# Mac's .git.
collect_worktree_mounts() {
  local dir=$1 real common line file
  common=$(git_common_dir "$dir") || return 0
  real=$(cd "$dir" && pwd -P)
  while IFS= read -r line; do
    file=${line#worktree }/.git
    if [ "$line" != "${line#worktree }" ] && [ -f "$file" ]; then
      add_pointer_mount "$file" "$real" "$dir"
    fi
  done < <(git -C "$dir" worktree list --porcelain)
  for file in "$common"/worktrees/*/commondir; do
    if [ -f "$file" ]; then
      add_pointer_mount "$file" "$real" "$dir"
    fi
  done
}

# Adds to mounts the file $1, read-only, at the real path git names it by.
# When $1 sits under $2, the real path of $3, it also mounts at the same place
# under $3. That is the path the container writes it by when $3 reaches the
# clone through a symbolic link.
add_pointer_mount() {
  mounts+=(-v "$1:$1:ro")
  if [ "$3" != "$2" ] && [ "${1#"$2"/}" != "$1" ]; then
    mounts+=(-v "$1:$3/${1#"$2"/}:ro")
  fi
}

# Adds to mounts the program's other repos: each directory next to this
# clone that is a clone itself, with an origin on the same host and owner as
# this one's. Each mounts read-only at its own path. The owner test keeps out
# whatever else shares the parent directory, such as another client's work
# or a partner folder. A worktree runs this too, so the parent is the main
# clone's, wherever the worktree sits: .worktrees, .claude/worktrees or
# elsewhere.
#
# A sibling named in writable_siblings mounts writable instead, with its
# .git/hooks and .git/config read-only, as compose.yaml mounts this repo's.
# Git runs commands from both, so a write there from the container would run
# on the Mac. The files that lead its worktrees to them mount read-only too.
collect_sibling_repos() {
  local main parent own dir name found=() writable=()
  main=$(main_clone)
  parent=$(dirname "$main")
  own=$(origin_owner "$main") || return 0
  # An origin the pattern cannot read, such as a local path, gives no owner.
  # Every sibling without a readable origin would match it.
  [ -n "$own" ] || return 0
  for dir in "$parent"/*; do
    [ "$dir" != "$main" ] && [ -d "$dir/.git" ] || continue
    [ "$(origin_owner "$dir")" = "$own" ] || continue
    name=$(basename "$dir")
    if is_writable_sibling "$name"; then
      # A missing source would become an empty directory the container
      # could fill, so make it here on the Mac first.
      mkdir -p "$dir/.git/hooks"
      mounts+=(-v "$dir:$dir"
        -v "$dir/.git/hooks:$dir/.git/hooks:ro"
        -v "$dir/.git/config:$dir/.git/config:ro")
      collect_worktree_mounts "$dir"
      writable+=("$name")
    else
      mounts+=(-v "$dir:$dir:ro")
      found+=("$name")
    fi
  done
  if [ ${#found[@]} -gt 0 ]; then
    echo "docker/cc: mounted read-only: ${found[*]}" >&2
  fi
  if [ ${#writable[@]} -gt 0 ]; then
    echo "docker/cc: mounted writable: ${writable[*]}" >&2
  fi
}

# Succeeds when $1 is named in writable_siblings.
is_writable_sibling() {
  local name
  for name in ${writable_siblings[@]+"${writable_siblings[@]}"}; do
    [ "$name" = "$1" ] && return 0
  done
  return 1
}

# Prints host/owner from the origin URL of the clone at $1, in lower case,
# because GitHub ignores case in both. Reads the SSH form
# (git@github.com:owner/repo), ssh:// and https://.
origin_owner() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  printf '%s\n' "$url" |
    sed -nE 's#^([a-z+]+://)?([^@/]+@)?([^:/]+)(:[0-9]+)?[:/]([^/]+)/.*#\3/\5#p' |
    tr '[:upper:]' '[:lower:]'
}

# gh on macOS keeps its token in the keychain. Hand the container the token
# itself; compose.yaml copies it from this shell, which keeps it off the
# command line where `ps` would show it.
export_gh_token() {
  GH_TOKEN=$(gh auth token 2>/dev/null || true)
  export GH_TOKEN
  if [ -z "$GH_TOKEN" ]; then
    echo "docker/cc: gh has no login on this machine, so git push and gh will fail inside" >&2
  fi
}

# The container's clock matches this one. /etc/localtime links into the zone
# database, and the part after zoneinfo/ is the zone's name.
export_timezone() {
  TZ=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
  export TZ
}

# Sets local_setup, the commands to run inside before Claude, and
# skip_marketplaces, the names of the folder marketplaces to keep out.
# docker/cc.local can change both, export variables, and redefine
# notify_host. It gets the arguments for Claude or bash as $@.
load_local_overrides() {
  local_setup=true
  skip_marketplaces=()
  if [ -f "$docker_dir/cc.local" ]; then
    # shellcheck source=/dev/null
    . "$docker_dir/cc.local"
  fi
}

# Adds to mounts, read-only at its own path, each folder that a plugin
# marketplace is read from on the Mac. Claude inside drops a marketplace's
# plugins when it cannot read the folder. known_marketplaces.json lists
# every marketplace, from settings.json and from /plugin marketplace add
# alike. Those with a source of "directory" are the folders.
#
# A marketplace named in skip_marketplaces stays out, such as one that
# belongs to another client. So does a folder the container already sees:
# one at or under the repo, a sibling repo, or a bind mount in the compose
# files, compose.local.yaml among them. A second mount there adds nothing,
# and under a writable mount it would turn the folder read-only.
collect_marketplaces() {
  local file=$HOME/.claude/plugins/known_marketplaces.json
  [ -f "$file" ] || return 0
  if ! command -v jq >/dev/null; then
    echo "docker/cc: jq is missing, so no folder marketplace mounted and their plugins will not load" >&2
    return 0
  fi
  local entries
  # Sorted by path, so a folder inside another marketplace's folder comes
  # after it, and counts as visible.
  if ! entries=$(jq -r 'to_entries
      | map(select(.value.source.source == "directory")
        | [.key, (.value.installLocation // .value.source.path)])
      | sort_by(.[1])[] | @tsv' "$file"); then
    echo "docker/cc: $file does not read as JSON, so no folder marketplace mounted" >&2
    return 0
  fi
  local name path arg visible=("$repo") compose_read="" mounted=() skipped=()
  for arg in ${mounts[@]+"${mounts[@]}"}; do
    [ "$arg" = -v ] || visible+=("$(mount_target "$arg")")
  done
  while IFS=$'\t' read -r name path; do
    [ -n "$name" ] || continue
    if is_skipped_marketplace "$name"; then
      skipped+=("$name")
      continue
    fi
    if [ ! -d "$path" ]; then
      echo "docker/cc: marketplace $name has no folder at $path on the Mac, so its plugins will not load" >&2
      continue
    fi
    # Only a marketplace to mount needs the compose files read.
    if [ -z "$compose_read" ]; then
      compose_read=1
      while IFS= read -r arg; do
        visible+=("$arg")
      done < <(compose_bind_targets)
    fi
    is_under_any "$path" "${visible[@]}" && continue
    mounts+=(-v "$path:$path:ro")
    visible+=("$path")
    mounted+=("$name")
  done <<<"$entries"
  if [ ${#mounted[@]} -gt 0 ]; then
    echo "docker/cc: mounted marketplaces read-only: ${mounted[*]}" >&2
  fi
  if [ ${#skipped[@]} -gt 0 ]; then
    echo "docker/cc: skipped marketplaces: ${skipped[*]}" >&2
  fi
}

# Succeeds when $1 is named in skip_marketplaces.
is_skipped_marketplace() {
  local name
  for name in ${skip_marketplaces[@]+"${skip_marketplaces[@]}"}; do
    [ "$name" = "$1" ] && return 0
  done
  return 1
}

# Prints the path inside of the -v argument $1, source:target or
# source:target:ro.
mount_target() {
  local target=${1#*:}
  printf '%s\n' "${target%:ro}"
}

# Prints the path inside of each bind mount the compose files give the
# claude service. A named volume, such as the login's, holds none of the
# Mac's files, so it does not count.
compose_bind_targets() {
  "${compose[@]}" config --format json 2>/dev/null |
    jq -r '.services.claude.volumes[]? | select(.type == "bind") | .target' 2>/dev/null || true
}

# Succeeds when the path $1 is one of the other arguments, or under one.
is_under_any() {
  local path=$1 dir
  shift
  for dir in "$@"; do
    if [ "$path" = "$dir" ] || [ "${path#"$dir"/}" != "$path" ]; then
      return 0
    fi
  done
  return 1
}

# The image's managed settings hook Stop and Notification to drop each event
# as a file into /run/cc-notify. That is this session's own directory, and a
# loop on the host hands each file to notify_host. A file drop needs no port,
# so two sessions never collide.
#
# compose replaces this script, through exec, so every signal reaches
# compose directly. compose keeps this script's process ID. The loop checks
# that ID on each pass. When the process has ended, the loop removes the
# directory and stops.
# Sets notify_dir and notify_log, which watch_events reads.
start_notify_watcher() {
  notify_dir=$(mktemp -d "${TMPDIR:-/tmp}/cc-notify.XXXXXX")
  # The notifier's output. It sits outside the directory, so it outlasts the
  # session.
  notify_log=${TMPDIR:-/tmp}/cc-notify.log
  watch_events &
}

# Runs $1, claude or bash, inside with the other arguments. Before it starts:
# point agent-browser at the Mac's Chrome, recreate the links, run the repo's
# start_commands, then run docker/cc.local's setup.
run_container() {
  local program=$1
  shift
  local setup
  setup="$(browser_setup)${links}{ $start_commands; } && { $local_setup; }"
  exec "${compose[@]}" run --rm ${mounts[@]+"${mounts[@]}"} \
    -v "$notify_dir:/run/cc-notify" claude \
    bash -c "$setup && exec $program \"\$@\"" "$program" "$@"
}

# Prints the shell text that points agent-browser inside at the Mac's Chrome,
# ending in " && ", or nothing when agent_browser_port is empty.
#
# agent-browser drives the Chrome that the repo opens on the Mac with remote
# debugging on that port. Chrome refuses a request that names a host other
# than localhost or an IP, so connect by the IP that host.docker.internal
# resolves to. It is looked up inside, at start, because Docker Desktop can
# change it. It takes the IPv4 address, because an IPv6 one would need
# brackets in the URL. If the name does not resolve, it warns and leaves the
# variable unset. The variable overrides agent-browser.json.
browser_setup() {
  [ -n "$agent_browser_port" ] || return 0
  # shellcheck disable=SC2016 # expands inside the container, not here
  printf '%s' 'mac_ip=$(getent ahostsv4 host.docker.internal | awk "NR == 1 {print \$1}")
if [ -n "$mac_ip" ]; then export AGENT_BROWSER_CDP=http://$mac_ip:'"$agent_browser_port"'
else echo "docker/cc: host.docker.internal does not resolve, so agent-browser cannot reach the Mac'"'"'s Chrome" >&2; fi && '
}

# Runs on the host for each Stop and Notification event inside. Its stdin is
# the event's JSON, and its working directory is the session's directory.
# It runs in this terminal's environment, so a notifier that checks
# $TMUX_PANE sees your pane. docker/cc.local can redefine it.
notify_host() {
  if command -v cc-notify.mjs >/dev/null; then cc-notify.mjs; fi
}

watch_events() {
  local event cwd
  # A hangup or TERM that reaches the loop still removes the directory.
  trap 'rm -rf "$notify_dir"' EXIT
  trap exit HUP TERM
  while kill -0 $$ 2>/dev/null; do
    for event in "$notify_dir"/*.json; do
      [ -e "$event" ] || continue
      # The repo mounts at its own path, so a directory under it inside is
      # the same directory on the host. Any other path falls back to the
      # repo root. So does a path with an escaped character, because the sed
      # does not decode JSON.
      cwd=$(sed -n 's/.*"cwd" *: *"\([^"]*\)".*/\1/p' "$event" | head -n 1) ||
        cwd=
      # One event runs at a time, with no time limit. A notifier that hangs
      # holds back every later event of the session.
      # Claude owns the terminal, so the notifier writes to the log instead.
      (
        case $cwd in
          "$repo" | "$repo"/*) cd "$cwd" 2>/dev/null || cd "$repo" ;;
          *) cd "$repo" ;;
        esac
        notify_host
      ) <"$event" >>"${notify_log:-/dev/null}" 2>&1 || true
      rm -f "$event"
    done
    sleep 0.5
  done
}

# The tests in the kit's test/ source this file, so main runs only when the
# file runs as a script.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi

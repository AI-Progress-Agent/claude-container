#!/usr/bin/env bash
# The claude-container launcher. It runs Claude Code for a repo in a
# container that mirrors the host's Claude setup: global CLAUDE.md, settings,
# hooks, output styles, skills, plugins, the status line, git identity, and
# the project's memory. The program's other repos cloned next to the repo
# mount read-only.
#
# A repo does not call this file directly. Its docker/cc stub copies this
# kit out of the image that docker/Dockerfile's FROM line names, once per
# image tag. Then it runs that copy with KIT_DOCKER_DIR set to the repo's
# docker directory. So these are the stub's commands:
#
#   docker/cc [args]      interactive Claude; args go to claude unchanged
#   docker/cc shell       a bash prompt in the same container
#   docker/cc build       build the image; again after mise.toml changes
#   docker/cc upgrade     rebuild from scratch, so every "latest" in the
#                         repo's mise config moves
#
# The first run asks you to sign in. The host keeps its login in the macOS
# keychain, which the container cannot read, so the container keeps its own
# in a volume. Later runs skip the sign-in.
#
# Every run is a fresh container. What lasts is in volumes, and in the host
# paths it mounts.
#
# Two committed files, both optional, carry what is the repo's alone:
#
#   docker/kit.sh               sourced by this script: the repo's settings,
#                               which load_repo_config lists
#   docker/compose.repo.yaml    stacked on compose.yaml: the repo's own
#                               volumes and environment variables
#
# Two uncommitted files, both optional, carry what is yours alone:
#
#   docker/compose.local.yaml   stacked on compose.repo.yaml: your own mounts
#                               and environment variables
#   docker/cc.local             sourced by this script before the container
#                               starts. It exports what those variables need.
#                               It appends to local_setup the commands to run
#                               inside before Claude. It can redefine
#                               notify_host to use your own notifier. It names
#                               in skip_marketplaces the folder marketplaces
#                               to keep out, and can add to nested_clones.
#
# KIT_DEV, set to the path of a claude-container checkout, tries a kit change
# on a real repo before a release. The stub runs that checkout's launcher,
# and build and upgrade build that checkout's base image first. The repo's
# image is then built on it, in place of the image the FROM line names.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# The repo's docker directory, and the repo that holds it.
docker_dir=${KIT_DOCKER_DIR:-}
repo=$(dirname "${docker_dir:-.}")

# The tag KIT_DEV builds its base image under.
dev_image=claude-container:dev

main() {
  : "${KIT_DOCKER_DIR:?run docker/cc in a repo, not the launcher itself}"
  load_repo_config
  export_compose_env
  build_compose_command

  local program=claude
  case "${1:-}" in
    build)
      shift
      build_dev_base
      exec "${compose[@]}" build "$@"
      ;;
    # A plain build reuses each cached layer, so nothing the repo's mise
    # config installs as "latest" ever moves. This skips the cache. Claude
    # and the base image's tools move only with a new base image: merge the
    # pull request that bumps the FROM line, then build.
    upgrade)
      shift
      build_dev_base
      exec "${compose[@]}" build --no-cache "$@"
      ;;
    shell)
      shift
      program=bash
      ;;
  esac

  # A run builds the image when it is missing. Under KIT_DEV, that build
  # needs the base image from the checkout.
  if [ -n "${KIT_DEV:-}" ] && ! docker image inspect "$dev_image" >/dev/null 2>&1; then
    build_dev_base
  fi

  # A bind mount whose source is missing becomes an empty directory owned by
  # root. compose.yaml mounts this one, and it may not exist yet.
  mkdir -p "$HOME/.claude/projects/$PROJECT_KEY"

  collect_host_mounts
  collect_worktree_mounts "$repo"
  collect_sibling_repos
  export_gh_token
  export_timezone
  load_local_overrides "$@"
  collect_nested_clones
  collect_hooks_paths
  collect_folder_mounts
  refuse_git_pointers
  collect_marketplaces
  start_notify_watcher
  run_container "$program" "$@"
}

# Sets the repo's settings to the kit's defaults, then sources docker/kit.sh,
# which can change any of them:
#
#   project_name        names the compose project, and so the image and the
#                       volumes, the login among them. The main clone's
#                       directory name plus -claude, by default. Two repos
#                       with one name would share a login and an image.
#   writable_siblings   the sibling repos that mount writable. None, by
#                       default. See collect_sibling_repos.
#   start_commands      shell commands run inside at each start, before
#                       docker/cc.local's local_setup. Nothing, by default.
#   agent_browser_port  the port of the Mac's Chrome that agent-browser
#                       drives. The cdp port in the repo's agent-browser.json,
#                       by default. Empty, agent-browser drives nothing on
#                       the Mac.
#   nested_clones       the clones and bare repos inside the repo kept on
#                       purpose, by their paths in the repo. None, by default.
#                       A clone inside a writable sibling goes by its
#                       absolute path. docker/cc.local can add more. See
#                       collect_nested_clones.
#
# kit.sh is sourced inside this function, so it sets each one by plain
# assignment. A `local` or a `declare` without -g there would be lost.
load_repo_config() {
  # Compose takes lower-case letters, digits, dashes and underscores only.
  project_name=$(basename "$(main_clone)" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' -)-claude
  writable_siblings=()
  start_commands=true
  nested_clones=()
  agent_browser_port=
  if [ -f "$repo/agent-browser.json" ]; then
    agent_browser_port=$(sed -nE 's/.*"cdp"[[:space:]]*:[[:space:]]*"?([0-9]+).*/\1/p' "$repo/agent-browser.json" | head -n 1)
  fi
  if [ -f "$docker_dir/kit.sh" ]; then
    # shellcheck source=/dev/null
    . "$docker_dir/kit.sh"
  fi
  if [ -f "$repo/agent-browser.json" ] && [ -z "$agent_browser_port" ]; then
    echo "docker/cc: agent-browser.json names no cdp port, so agent-browser drives nothing on the Mac" >&2
  fi
}

# Prints the main clone's path. From a worktree, that is the clone the
# worktree belongs to, wherever the worktree sits. Outside git, it is the
# repo itself.
main_clone() {
  local dir
  if dir=$(git_common_dir "$repo"); then
    dirname "$dir"
  else
    printf '%s\n' "$repo"
  fi
}

# compose.yaml reads these. The image is built for this user and home path,
# so a teammate building it gets their own.
export_compose_env() {
  export PROJECT_NAME=$project_name
  export REPO=$repo
  # Not GIT_COMMON_DIR: git reads that name, and would then send every git
  # command here to this repo.
  REPO_GIT=$(repo_git_dir)
  # Below the clone's root, git inside stops at the repo's mount and never
  # finds the clone's .git. Nothing inside needs to write it, so it mounts
  # read-only there.
  REPO_GIT_MODE=rw
  if [ -n "$(git -C "$repo" rev-parse --show-prefix 2>/dev/null)" ]; then
    REPO_GIT_MODE=ro
  fi
  export REPO_GIT REPO_GIT_MODE
  export HOST_HOME=$HOME
  HOST_USER=$(id -un)
  export HOST_USER
  # Claude names a project's directory under ~/.claude/projects after its
  # path, with every character that is not a letter or digit turned into a
  # dash.
  PROJECT_KEY=$(printf '%s' "$repo" | sed 's/[^A-Za-z0-9]/-/g')
  export PROJECT_KEY
}

# Prints the path of the git directory that holds the repo's hooks and
# config. In the main clone or outside git, that is the repo's own .git. It
# keeps the repo's path here, where git inside looks for it. A linked
# worktree's .git is a file that points into the main clone's .git, so this
# prints the main clone's .git. That path has no symbolic links, as the
# worktree's .git file names it.
repo_git_dir() {
  local dir
  if [ ! -d "$repo/.git" ] && dir=$(git_common_dir "$repo"); then
    printf '%s\n' "$dir"
  else
    printf '%s\n' "$repo/.git"
  fi
}

# Prints the absolute path of the git directory shared by $1's clone and all
# its worktrees: the main clone's .git. Git prints it by its real path. Fails
# outside git.
git_common_dir() {
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# Sets compose, the docker compose command with the kit's compose file and
# the repo's. Relative paths in the repo's files resolve against its docker
# directory, as they would if the kit's file sat there too. -p names the
# project, because a COMPOSE_PROJECT_NAME in your shell would otherwise win
# over compose.yaml's name and give two repos one login.
build_compose_command() {
  compose=(docker compose -p "$project_name" --project-directory "$docker_dir" -f "$here/compose.yaml")
  local file
  for file in compose.repo.yaml compose.local.yaml; do
    if [ -f "$docker_dir/$file" ]; then
      compose+=(-f "$docker_dir/$file")
    fi
  done
  if [ -n "${KIT_DEV:-}" ]; then
    compose+=(-f "$(write_dev_override)")
  fi
}

# Builds the base image from the KIT_DEV checkout, when KIT_DEV is set.
build_dev_base() {
  if [ -n "${KIT_DEV:-}" ]; then
    docker build -t "$dev_image" "$KIT_DEV"
  fi
}

# Writes a compose file that builds the repo's image on the KIT_DEV base, and
# prints its path. A build context named after the image in the FROM line
# takes that image's place, so the FROM line, digest and all, stays as it is.
# The stub sets KIT_BASE_IMAGE to that image.
write_dev_override() {
  local file=${XDG_CACHE_HOME:-$HOME/.cache}/claude-container/dev/$project_name.yaml
  mkdir -p "$(dirname "$file")"
  printf 'services:\n  claude:\n    build:\n      additional_contexts:\n        "%s": docker-image://%s\n' \
    "${KIT_BASE_IMAGE:?the stub sets KIT_BASE_IMAGE}" "$dev_image" >"$file"
  printf '%s\n' "$file"
}

# Sets mounts, the -v arguments for the run, and links, the shell text that
# recreates each mounted link inside. Empties guarded_git_dirs, which
# guard_git_dir fills.
collect_host_mounts() {
  # Host config to mirror, each read-only at its own path inside. A path this
  # machine does not have is left out, so any Claude setup runs as it is.
  # Links resolve only if their targets are mounted too: mount a dotfiles
  # repo in docker/compose.local.yaml. collect_marketplaces mounts the
  # folders that plugin marketplaces are read from.
  local optional=(
    .claude/CLAUDE.md
    .claude/settings.json
    .claude/settings.local.json
    .claude/output-styles
    .claude/skills
    .claude/agents
    .claude/commands
    .claude/hooks
    # installed_plugins.json names each plugin by its absolute host path.
    .claude/plugins
    # Where the skills CLI installs shared skills.
    .agents
    # Scripts the status line and hooks call by name. The image puts ~/bin
    # last on PATH.
    bin
    .config/ccstatusline
    .gitconfig
    .gitconfig.local
    .config/git
  )
  #
  # A file mounted on its own is pinned to the copy that existed at start. An
  # editor that saves by writing a new copy and renaming it over the old one
  # leaves the container reading the deleted original, and Claude drops every
  # setting in it without a word. Nothing fixes that for a plain file in
  # $HOME. A file that is a link, into a dotfiles repo say, can be fixed:
  # mount the directory its target is in, which follows the rename, and
  # recreate the link inside, pointing there. Those directories mount under
  # /mnt/host-links, not at their own paths, so they never collide with a
  # mount in compose.local.yaml.
  mounts=()
  links=
  guarded_git_dirs=()
  local link_dirs=()
  local path src target parent dir d i
  for path in "${optional[@]}"; do
    src=$HOME/$path
    [ -e "$src" ] || continue
    if [ -L "$src" ] && [ -f "$src" ]; then
      target=$(realpath "$src")
      parent=$(dirname "$target")
      dir=
      i=0
      for d in ${link_dirs[@]+"${link_dirs[@]}"}; do
        [ "$d" = "$parent" ] && dir=/mnt/host-links/$i
        i=$((i + 1))
      done
      if [ -z "$dir" ]; then
        dir=/mnt/host-links/$i
        link_dirs+=("$parent")
        mounts+=(-v "$parent:$dir:ro")
      fi
      links+=$(printf 'ln -sfn %q %q && ' "$dir/$(basename "$target")" "$src")
    else
      mounts+=(-v "$src:$src:ro")
    fi
  done
}

# Adds to mounts, read-only, the files that lead each worktree's git to the
# hooks and config. $1 is a directory in a clone, by the path the container
# sees it at. A linked worktree's .git file names its git directory, under
# worktrees/ in the main clone's .git. That directory's commondir file names
# the main clone's .git. Both sit in writable mounts otherwise. The container
# could then point git on the Mac at a config of its own. That config would
# get past the read-only mounts of hooks and config. This covers every
# worktree of the clone, not only the one docker/cc runs from.
#
# The main clone's .git gets the same guard as every git directory of its
# own: see guard_git_dir. So does each submodule's git directory, kept under
# modules/ in the main clone's .git. Git in the repo runs git in each
# submodule, so a config written there runs on the Mac at git status. Each
# one's hooks and config mount read-only too.
#
# Each worktree's .git file mounts even where the worktree does not. Without
# it, git inside takes a worktree it cannot see for a deleted one. Then git
# worktree prune, or git gc, removes its git directory from the Mac's .git.
collect_worktree_mounts() {
  local dir=$1 real common line file module
  common=$(git_common_dir "$dir") || return 0
  real=$(real_dir "$dir")
  while IFS= read -r line; do
    file=${line#worktree }/.git
    if [ "$line" != "${line#worktree }" ] && [ -f "$file" ]; then
      add_git_file_mount "$file" "$real" "$dir"
    fi
  done < <(git -C "$dir" worktree list --porcelain)
  guard_git_dir "$common" "$real" "$dir"
  while IFS= read -r module; do
    guard_whole_git_dir "$module" "$real" "$dir"
  done < <(submodule_git_dirs "$common")
}

# Adds the git directory $1 to guarded_git_dirs, and adds to mounts,
# read-only, the files in it that could send git elsewhere. $1 is a git
# directory of its own, not a worktree's. $2 and $3 are as add_git_file_mount
# takes them.
#
# Each worktree's git directory under $1/worktrees has a commondir file that
# names $1. Each one mounts read-only.
#
# A commondir file in $1 would send git to the hooks and config of the
# directory it names. A missing file cannot mount: Docker would make it empty,
# and git fails on an empty one. So a missing one is made on the Mac first,
# naming $1 itself, which git reads as no commondir at all. It names $1 as ../
# and $1's own name, not as ".", because libgit2 cannot open a repo whose
# commondir is ".". One that names another directory, or is a link, does not
# mount, and refuse_git_pointers names it. The launcher does not write to the
# file a link names.
#
# With extensions.worktreeConfig on, git also reads config.worktree in $1,
# and in each worktree's git directory under $1/worktrees. Each one mounts
# read-only too. A missing one is made empty on the Mac first. Otherwise the
# container could make it in the writable mount.
guard_git_dir() {
  local git_dir=$1 file dir
  guarded_git_dirs+=("$(real_dir "$git_dir")")
  for file in "$git_dir"/worktrees/*/commondir; do
    if [ -f "$file" ]; then
      add_git_file_mount "$file" "$2" "$3"
    fi
  done
  file=$git_dir/commondir
  if ! path_exists "$file"; then
    printf '../%s\n' "$(basename "$git_dir")" >"$file"
  fi
  if commondir_names_itself "$git_dir"; then
    add_git_file_mount "$file" "$2" "$3"
  fi
  if worktree_config_on "$git_dir"; then
    for dir in "$git_dir" "$git_dir"/worktrees/*; do
      if [ -d "$dir" ]; then
        touch "$dir/config.worktree"
        add_git_file_mount "$dir/config.worktree" "$2" "$3"
      fi
    done
  fi
}

# Adds to mounts, read-only, the hooks and config of the git directory $1,
# then guards $1 as guard_git_dir does. This is for a git directory that
# compose.yaml and guard_clone do not mount, such as a submodule's. A missing
# hooks directory would become an empty one the container could fill, so it
# is made on the Mac first. So is a missing config, as an empty file. $2 and
# $3 are as add_git_file_mount takes them.
guard_whole_git_dir() {
  mkdir -p "$1/hooks"
  touch "$1/config"
  add_git_file_mount "$1/hooks" "$2" "$3"
  add_git_file_mount "$1/config" "$2" "$3"
  guard_git_dir "$1" "$2" "$3"
}

# Adds to mounts, read-only, the clone $1's .git/hooks and .git/config, and
# the files that lead git to them. A missing hooks directory would become an
# empty one the container could fill, so it is made on the Mac first.
guard_clone() {
  mkdir -p "$1/.git/hooks"
  mounts+=(-v "$1/.git/hooks:$1/.git/hooks:ro"
    -v "$1/.git/config:$1/.git/config:ro")
  collect_worktree_mounts "$1"
}

# Succeeds when the commondir file in the git directory $1 is a file, not a
# link, and names $1 itself.
commondir_names_itself() {
  [ ! -L "$1/commondir" ] && names_dir "$1/commondir" "$1" "$1"
}

# Succeeds when the config of the git directory $1 turns on
# extensions.worktreeConfig, so git also reads each config.worktree.
worktree_config_on() {
  [ "$(git config -f "$1/config" --bool extensions.worktreeConfig 2>/dev/null)" = true ]
}

# Prints the git directory of each submodule under the git directory $1, and
# of each submodule's own submodules: each directory under a modules/ there
# that holds a HEAD file and an objects directory.
submodule_git_dirs() {
  local head
  find "$1/modules" "$1"/worktrees/*/modules -name objects -prune -o \
    -name HEAD -type f -print 2>/dev/null |
    while IFS= read -r head; do
      if [ -d "${head%/HEAD}/objects" ]; then
        printf '%s\n' "${head%/HEAD}"
      fi
    done
}

# Succeeds when the file $1, a commondir or a .git file, names the directory
# $3. A relative name is relative to the directory $2.
names_dir() {
  local named
  named=$(named_dir "$1" "$2") && [ "$named" = "$(real_dir "$3")" ]
}

# Prints the real path of the directory that the file $1, a commondir or a
# .git file, names. A relative name is relative to the directory $2. A .git
# file names its directory after "gitdir: ". Fails when $1 names no
# directory.
named_dir() {
  local name
  name=$(sed -n '1s/^gitdir: //;1p' "$1" 2>/dev/null) && [ -n "$name" ] || return 1
  real_dir "$(absolute_path "$name" "$2")"
}

# Prints the real path of the directory $1, each name in it spelled as on
# disk, as git prints it. The Mac's disk ignores case, and the shell's own
# pwd keeps the case it was given, so /bin/pwd prints it. Fails when $1 is
# not a directory.
real_dir() {
  (cd "$1" 2>/dev/null && /bin/pwd -P)
}

# Succeeds when something is at the path $1: a file, a directory or a link,
# even a link to nothing.
path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

# Adds to mounts the file $1, read-only, at the real path git names it by.
# When $1 sits under $2, the real path of $3, it also mounts at the same place
# under $3. That is the path the container writes it by. $3 differs from $2
# when it reaches the clone through a symbolic link, or in other letter case.
add_git_file_mount() {
  mounts+=(-v "$1:$1:ro")
  if [ "$3" != "$2" ] && is_under_any "$1" "$2"; then
    mounts+=(-v "$1:$3/${1#"$2"/}:ro")
  fi
}

# Succeeds when the path $1 is one of the other arguments, or under one.
is_under_any() {
  local path=$1 dir
  shift
  for dir in "$@"; do
    if [ "$path" = "$dir" ] || [ "${path#"$dir"/}" != "$path" ]; then
      return 0
    fi
  done
  return 1
}

# Adds to mounts the program's other repos: each directory next to this
# clone that is a clone itself, with an origin on the same host and owner as
# this one's. Each mounts read-only at its own path. The owner test keeps out
# whatever else shares the parent directory, such as another client's work
# or a partner folder. A worktree runs this too, so the parent is the main
# clone's, wherever the worktree sits: .worktrees, .claude/worktrees or
# elsewhere.
#
# A sibling named in writable_siblings mounts writable instead, with its
# .git/hooks and .git/config read-only, as compose.yaml mounts this repo's.
# Git runs commands from both, so a write there from the container would run
# on the Mac. The files that lead its worktrees to them mount read-only too.
# Sets writable_dirs, the paths of those siblings.
collect_sibling_repos() {
  local main parent own dir name found=() writable=()
  writable_dirs=()
  main=$(main_clone)
  parent=$(dirname "$main")
  own=$(origin_owner "$main") || return 0
  # An origin the pattern cannot read, such as a local path, gives no owner.
  # Every sibling without a readable origin would match it.
  [ -n "$own" ] || return 0
  for dir in "$parent"/*; do
    [ "$dir" != "$main" ] && [ -d "$dir/.git" ] || continue
    [ "$(origin_owner "$dir")" = "$own" ] || continue
    name=$(basename "$dir")
    if is_one_of "$name" ${writable_siblings[@]+"${writable_siblings[@]}"}; then
      mounts+=(-v "$dir:$dir")
      guard_clone "$dir"
      writable_dirs+=("$dir")
      writable+=("$name")
    else
      mounts+=(-v "$dir:$dir:ro")
      found+=("$name")
    fi
  done
  if [ ${#found[@]} -gt 0 ]; then
    echo "docker/cc: mounted read-only: ${found[*]}" >&2
  fi
  if [ ${#writable[@]} -gt 0 ]; then
    echo "docker/cc: mounted writable: ${writable[*]}" >&2
  fi
}

# Succeeds when $1 is one of the other arguments.
is_one_of() {
  local name=$1 item
  shift
  for item in "$@"; do
    [ "$item" = "$name" ] && return 0
  done
  return 1
}

# Prints host/owner from the origin URL of the clone at $1, in lower case,
# because GitHub ignores case in both. Reads the SSH form
# (git@github.com:owner/repo), ssh:// and https://.
origin_owner() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  printf '%s\n' "$url" |
    sed -nE 's#^([a-z+]+://)?([^@/]+@)?([^:/]+)(:[0-9]+)?[:/]([^/]+)/.*#\3/\5#p' |
    tr '[:upper:]' '[:lower:]'
}

# gh on macOS keeps its token in the keychain. Hand the container the token
# itself; compose.yaml copies it from this shell, which keeps it off the
# command line where `ps` would show it.
export_gh_token() {
  GH_TOKEN=$(gh auth token 2>/dev/null || true)
  export GH_TOKEN
  if [ -z "$GH_TOKEN" ]; then
    echo "docker/cc: gh has no login on this machine, so git push and gh will fail inside" >&2
  fi
}

# The container's clock matches this one. /etc/localtime links into the zone
# database, and the part after zoneinfo/ is the zone's name.
export_timezone() {
  TZ=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
  export TZ
}

# Sets local_setup, the commands to run inside before Claude, and
# skip_marketplaces, the names of the folder marketplaces to keep out.
# docker/cc.local can change both, export variables, and redefine
# notify_host. It gets the arguments for Claude or bash as $@.
load_local_overrides() {
  local_setup=true
  skip_marketplaces=()
  if [ -f "$docker_dir/cc.local" ]; then
    # shellcheck source=/dev/null
    . "$docker_dir/cc.local"
  fi
}

# Guards each clone that nested_clones names, as collect_sibling_repos
# guards a writable sibling. Its .git/hooks, its .git/config and the files
# that lead git to them mount read-only. A bare repo named there, such as a
# test fixture, gets its own hooks and config mounted read-only too.
#
# A path in nested_clones is relative to the repo. An absolute path names a
# clone inside a writable sibling.
#
# The container could write any other clone or bare repo inside the repo, so
# refuse_git_pointers refuses to start. A named path that holds neither is
# not guarded. So a clone made there during the session is moved aside.
collect_nested_clones() {
  local path dir guarded=()
  for path in ${nested_clones[@]+"${nested_clones[@]}"}; do
    dir=$(absolute_path "${path%/}" "$repo")
    if [ -d "$dir/.git" ]; then
      guard_clone "$dir"
    elif [ -f "$dir/HEAD" ] && has_git_dir_parts "$dir"; then
      guard_whole_git_dir "$dir" "$dir" "$dir"
    else
      echo "docker/cc: nested clone $path has no .git directory and is no bare repo, so it is not guarded" >&2
      continue
    fi
    guarded+=("$path")
  done
  if [ ${#guarded[@]} -gt 0 ]; then
    echo "docker/cc: guarded nested clones: ${guarded[*]}" >&2
  fi
}

# Adds to mounts, read-only at its own path, the folder that core.hooksPath
# names for each worktree. Only a folder inside a writable mount mounts. Git
# on the Mac runs hooks from there, so a hook written inside would run on the
# Mac. Husky's .gitignore in the folder leaves out every file, so git status
# would not show it. The worktrees are those of each guarded git directory: the
# repo's, each writable sibling's, each nested clone's and each submodule's.
# The value comes from any config git reads, the global one among them.
#
# Git resolves a relative value in the worktree, and in a bare repo's git
# directory. A missing folder is made empty on the Mac first, and stays after
# the session. A folder that is already read-only, such as .git/hooks, needs
# nothing new. collect_folder_mounts then mounts each folder above it.
#
# The launcher cannot guard some folders. It names the worktree and the value
# of each one, and exits before the container starts. Each one is:
#
#   - a writable mount, or a folder that holds one
#   - inside a writable mount, and holds its worktree or a read-only mount
#   - reached through a symbolic link inside a writable mount. The container
#     could point the link elsewhere.
#   - a path through a file, which cannot be a folder
#
# It decides on every worktree before it makes a folder, so a refused start
# makes none.
collect_hooks_paths() {
  local typed_roots=() real_roots=() read_only=() refused=() hooks=()
  local arg dir worktree value folder real root i
  while IFS= read -r dir; do
    real=$(real_dir "$dir") || continue
    typed_roots+=("$dir")
    real_roots+=("$real")
  done < <(writable_mounts)
  for arg in ${mounts[@]+"${mounts[@]}"}; do
    case $arg in *:ro) ;; *) continue ;; esac
    dir=$(mount_target "$arg")
    read_only+=("$dir")
    if [ -d "$dir" ] && real=$(real_dir "$dir") && [ "$real" != "$dir" ]; then
      read_only+=("$real")
    fi
  done
  # compose.yaml mounts this one.
  if real=$(real_dir "$REPO_GIT"); then
    read_only+=("$real/hooks")
  fi
  while IFS= read -r worktree; do
    # Git refuses an empty value, so it runs no hook.
    value=$(git -C "$worktree" config core.hooksPath 2>/dev/null) && [ -n "$value" ] || continue
    folder=$(absolute_path "$(git -C "$worktree" config --type=path core.hooksPath)" "$worktree")
    if ! folder=$(follow_links "$folder" "${real_roots[@]}") ||
      holds_any "$folder" "${real_roots[@]}"; then
      refused+=("$worktree: core.hooksPath = $value")
      continue
    fi
    root=$(containing_index "$folder" "${real_roots[@]}") || continue
    is_under_any "$folder" ${read_only[@]+"${read_only[@]}"} && continue
    if holds_any "$folder" "$worktree" ${read_only[@]+"${read_only[@]}"} || ! nearest_is_dir "$folder"; then
      refused+=("$worktree: core.hooksPath = $value")
      continue
    fi
    hooks+=("$folder" "${real_roots[root]}" "${typed_roots[root]}")
    read_only+=("$folder")
  done < <(guarded_worktrees)
  if [ ${#refused[@]} -gt 0 ]; then
    {
      echo "docker/cc: core.hooksPath names a folder the launcher cannot mount read-only, so the container did not start:"
      printf '  %s\n' "${refused[@]}"
      echo "Point core.hooksPath at a folder below the worktree's root, with no symbolic link on the way. Or unset it."
    } >&2
    exit 1
  fi
  for ((i = 0; i < ${#hooks[@]}; i += 3)); do
    mkdir -p "${hooks[i]}"
    add_git_file_mount "${hooks[i]}" "${hooks[i + 1]}" "${hooks[i + 2]}"
  done
}

# Prints the path of each worktree of each guarded git directory, one per
# line. A bare repo has no worktree, so its git directory stands in for one:
# git resolves a relative core.hooksPath there. A worktree whose folder is
# missing is left out.
#
# A submodule's git directory lists itself for its checkout, which its
# core.worktree names, relative to it. Git ignores core.worktree there once
# guard_git_dir writes a commondir, so this reads it.
guarded_worktrees() {
  local git_dir line worktree dir
  for git_dir in ${guarded_git_dirs[@]+"${guarded_git_dirs[@]}"}; do
    while IFS= read -r line; do
      [ "$line" != "${line#worktree }" ] || continue
      worktree=${line#worktree }
      if [ "$worktree" = "$git_dir" ] &&
        dir=$(git config -f "$git_dir/config" core.worktree 2>/dev/null); then
        worktree=$(absolute_path "$dir" "$git_dir")
      fi
      real_dir "$worktree" || true
    done < <(git --git-dir="$git_dir" worktree list --porcelain)
  done
}

# Prints the path $1, made absolute against the directory $2 when relative.
absolute_path() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$2/$1" ;;
  esac
}

# Prints the path $1 with each symbolic link in it followed, as the kernel
# follows them. $1 is absolute. A part of it may be missing. Fails when a
# link sits at or under one of the other arguments, or when links loop.
follow_links() {
  local rest=$1 path='' part hops=0
  shift
  while [ -n "$rest" ]; do
    part=${rest%%/*}
    rest=${rest#"$part"}
    rest=${rest#/}
    case $part in
      '' | .) continue ;;
      ..)
        path=${path%/*}
        continue
        ;;
    esac
    if [ -L "$path/$part" ]; then
      is_under_any "$path/$part" "$@" && return 1
      hops=$((hops + 1))
      [ $hops -le 40 ] || return 1
      part=$(readlink "$path/$part")
      case $part in /*) path= ;; esac
      rest=$part/$rest
    else
      path=$path/$part
    fi
  done
  printf '%s\n' "${path:-/}"
}

# Succeeds when one of the other arguments is the path $1, or under it.
holds_any() {
  local dir=$1 path
  shift
  for path in "$@"; do
    is_under_any "$path" "$dir" && return 0
  done
  return 1
}

# Prints the index of the first of the other arguments that the path $1 is,
# or sits under. Fails when there is none.
containing_index() {
  local path=$1 i=0 dir
  shift
  for dir in "$@"; do
    if is_under_any "$path" "$dir"; then
      printf '%s\n' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

# Succeeds when the deepest part of the path $1 that exists is a directory.
nearest_is_dir() {
  local path=$1
  while ! path_exists "$path"; do
    path=$(dirname "$path")
  done
  [ -d "$path" ]
}

# Adds to mounts, writable at its own path, each folder above a read-only
# mount that sits inside a writable mount. Linux lets the container rename a
# folder that holds a mount. The mount moves with the folder. The container
# could then make a new folder at the old path, with its own config or hooks.
# Git on the Mac would read them. Linux refuses to rename a mount point. So
# each folder from the writable mount's root down to the read-only mount gets
# a mount of its own. Writes inside each one still work.
#
# The writable mounts are the repo, each writable sibling, and the repo's git
# directory when it mounts writable. The read-only mounts are those in mounts.
# Those that compose.yaml adds sit directly in the repo's git directory, a
# mount point, so they need no folder mounts. A folder that is already a mount
# point needs no new one. That includes a folder that a compose file mounts:
# a second mount there would hide it. The launcher can mount a read-only file
# a second time, at the repo's path as typed. Then that copy's folders mount
# at that path too, because the writable repo mounts there.
collect_folder_mounts() {
  local writable=() mount_points=("$repo" "$REPO_GIT") read_only=() folders=()
  local arg target root dir
  while IFS= read -r dir; do
    writable+=("$dir")
  done < <(writable_mounts)
  for arg in ${mounts[@]+"${mounts[@]}"}; do
    [ "$arg" != -v ] || continue
    target=$(mount_target "$arg")
    mount_points+=("$target")
    case $arg in *:ro) read_only+=("$target") ;; esac
  done
  for target in ${read_only[@]+"${read_only[@]}"}; do
    root=$(innermost_mount "$target" "${writable[@]}") || continue
    dir=${target%/*}
    while [ "$dir" != "$root" ]; do
      folders+=("$dir")
      dir=${dir%/*}
    done
  done
  [ ${#folders[@]} -gt 0 ] || return 0
  while IFS= read -r target; do
    mount_points+=("$target")
  done < <(compose_bind_targets "a folder mount may hide a mount from a compose file")
  for dir in "${folders[@]}"; do
    is_one_of "$dir" "${mount_points[@]}" && continue
    mounts+=(-v "$dir:$dir")
    mount_points+=("$dir")
  done
}

# Prints the path of each writable mount, one per line: the repo, the repo's
# git directory when it mounts writable, and each writable sibling.
writable_mounts() {
  local dir
  printf '%s\n' "$repo"
  if [ "$REPO_GIT_MODE" = rw ]; then
    printf '%s\n' "$REPO_GIT"
  fi
  for dir in ${writable_dirs[@]+"${writable_dirs[@]}"}; do
    printf '%s\n' "$dir"
  done
}

# Prints the longest of the other arguments that the path $1 sits under, not
# at. Fails when it sits under none.
innermost_mount() {
  local path=$1 dir inner=
  shift
  for dir in "$@"; do
    if [ "${path#"$dir"/}" != "$path" ] && [ ${#dir} -gt ${#inner} ]; then
      inner=$dir
    fi
  done
  [ -n "$inner" ] && printf '%s\n' "$inner"
}

# Exits before the container starts when find_git_pointers finds a file. The
# file is already on the Mac, so the launcher names it and leaves it for you.
refuse_git_pointers() {
  local found=() path
  while IFS= read -r path; do
    found+=("$path")
  done < <(find_git_pointers)
  [ ${#found[@]} -gt 0 ] || return 0
  {
    echo "docker/cc: these could lead git on the Mac to hooks or a config written inside, so the container did not start:"
    printf '  %s\n' "${found[@]}"
    echo "Delete each one. To keep a clone or a bare repo inside the repo or a writable sibling, add its path to nested_clones in docker/kit.sh or docker/cc.local."
  } >&2
  exit 1
}

# Prints each path that could lead git on the Mac to hooks or a config that
# the container wrote, one per line. The repo and each writable sibling are
# searched, since the container can write anywhere in them. A path is one of:
#
#   - a commondir in a guarded git directory that names another directory, or
#     is a link
#   - a .git, as a directory, a file or a link, that does not lead to a
#     guarded git directory. See leads_to_guarded.
#   - the HEAD of a directory that git takes for a git directory, with no
#     .git: see has_git_dir_parts. HEAD can be a link too. A HEAD inside a
#     guarded git directory, such as a bare repo that nested_clones names,
#     is left alone.
#
# The Mac's disk ignores case by default, so git takes .GIT for .git, and
# head for HEAD. The search ignores case too. It does not go into a .git, so
# it skips the git directories themselves, guarded or not. It does go into a
# .git that block_git_pointers moved aside. Git can still open a git
# directory in it, such as a submodule's, so a later search finds each one.
# The container can choose any name, so no name is skipped.
find_git_pointers() {
  local dir path
  for dir in ${guarded_git_dirs[@]+"${guarded_git_dirs[@]}"}; do
    if path_exists "$dir/commondir" && ! commondir_names_itself "$dir"; then
      printf '%s\n' "$dir/commondir"
    fi
  done
  while IFS= read -r path; do
    case $path in
      */.[gG][iI][tT])
        leads_to_guarded "$path" || printf '%s\n' "$path"
        ;;
      */[hH][eE][aA][dD])
        dir=$(dirname "$path")
        if has_git_dir_parts "$dir" &&
          ! is_under_any "$(real_dir "$dir")" ${guarded_git_dirs[@]+"${guarded_git_dirs[@]}"}; then
          printf '%s\n' "$path"
        fi
        ;;
    esac
  done < <(find "$repo" ${writable_dirs[@]+"${writable_dirs[@]}"} \
    -iname .git -prune -print -o -iname HEAD \( -type f -o -type l \) -print 2>/dev/null)
}

# Succeeds when the directory $1, if it holds a HEAD, is one that git takes
# for a git directory. It does when $1 holds a commondir, or both objects and
# refs. With a commondir, git looks for objects and refs in the directory it
# names instead. Git also accepts objects and refs as files. So this checks
# only that each one exists.
has_git_dir_parts() {
  path_exists "$1/commondir" ||
    { path_exists "$1/objects" && path_exists "$1/refs"; }
}

# Succeeds when the .git at $1 leads git to a guarded git directory. It does
# when it is one, or names one. It also does when it names a worktree's git
# directory, <guarded>/worktrees/<name>, and both files git reads there are
# safe. Its commondir must name that guarded directory. Its config.worktree,
# read only with extensions.worktreeConfig on, must be empty or read-only.
# git worktree add inside makes such a worktree, so this lets one through.
leads_to_guarded() {
  local gitdir common
  if [ -d "$1" ]; then
    gitdir=$(real_dir "$1") || return 1
  else
    gitdir=$(named_dir "$1" "$(dirname "$1")") || return 1
  fi
  is_one_of "$gitdir" ${guarded_git_dirs[@]+"${guarded_git_dirs[@]}"} && return 0
  [ "$(basename "$(dirname "$gitdir")")" = worktrees ] || return 1
  common=$(dirname "$(dirname "$gitdir")")
  is_one_of "$common" ${guarded_git_dirs[@]+"${guarded_git_dirs[@]}"} || return 1
  names_dir "$gitdir/commondir" "$gitdir" "$common" || return 1
  [ -s "$gitdir/config.worktree" ] || return 0
  ! worktree_config_on "$common" ||
    is_one_of "$gitdir/config.worktree:$gitdir/config.worktree:ro" ${mounts[@]+"${mounts[@]}"}
}

# Adds to mounts, read-only at its own path, each folder that a plugin
# marketplace is read from on the Mac. Claude inside drops a marketplace's
# plugins when it cannot read the folder. folder_marketplaces finds them.
#
# A marketplace named in skip_marketplaces stays out, such as one that
# belongs to another client. So does a folder the container already sees.
# That is a folder at or under the repo or a sibling repo. It is also one at
# or under a bind mount in any compose file, compose.local.yaml among them. A
# second mount there adds nothing. Under a writable mount, it would turn the
# folder read-only.
collect_marketplaces() {
  local known=$HOME/.claude/plugins/known_marketplaces.json
  local settings=$HOME/.claude/settings.json
  [ -f "$known" ] || [ -f "$settings" ] || return 0
  if ! command -v jq >/dev/null; then
    echo "docker/cc: jq is missing, so no folder marketplace mounted and their plugins will not load" >&2
    return 0
  fi
  local entries
  if ! entries=$(folder_marketplaces "$known" "$settings"); then
    echo "docker/cc: $known or $settings does not read as JSON, so no folder marketplace mounted" >&2
    return 0
  fi
  local name path arg visible=("$repo") compose_read="" mounted=() skipped=()
  for arg in ${mounts[@]+"${mounts[@]}"}; do
    [ "$arg" = -v ] || visible+=("$(mount_target "$arg")")
  done
  while IFS= read -r name && IFS= read -r path; do
    if is_one_of "$name" ${skip_marketplaces[@]+"${skip_marketplaces[@]}"}; then
      skipped+=("$name")
      continue
    fi
    if [ ! -d "$path" ]; then
      echo "docker/cc: marketplace $name has no folder at $path on the Mac, so its plugins will not load" >&2
      continue
    fi
    # Only a marketplace to mount needs the compose files read.
    if [ -z "$compose_read" ]; then
      compose_read=1
      while IFS= read -r arg; do
        visible+=("$arg")
      done < <(compose_bind_targets "a marketplace that a compose file mounts may mount twice")
    fi
    is_under_any "$path" "${visible[@]}" && continue
    mounts+=(-v "$path:$path:ro")
    visible+=("$path")
    mounted+=("$name")
  done <<<"$entries"
  if [ ${#mounted[@]} -gt 0 ]; then
    echo "docker/cc: mounted marketplaces read-only: ${mounted[*]}" >&2
  fi
  if [ ${#skipped[@]} -gt 0 ]; then
    echo "docker/cc: skipped marketplaces: ${skipped[*]}" >&2
  fi
}

# Prints each folder marketplace as two lines: its name, then its path.
# $1 is known_marketplaces.json and $2 is settings.json. Either may be
# missing. known_marketplaces.json lists every marketplace, from settings.json
# and from /plugin marketplace add alike. Those with a source of "directory"
# are the folders. The file can lag behind settings.json, such as on a new
# machine. So an entry under extraKnownMarketplaces in settings.json wins
# when the file's entry differs or is missing.
#
# Sorted by path, so a folder inside another marketplace's folder comes
# after it, and counts as visible.
folder_marketplaces() {
  jq -n -r \
    --slurpfile known <(cat "$1" 2>/dev/null) \
    --slurpfile settings <(cat "$2" 2>/dev/null) '
    reduce (($settings[0].extraKnownMarketplaces // {}) | to_entries[]) as $e
      ($known[0] // {};
        if .[$e.key].source == $e.value.source then . else .[$e.key] = $e.value end)
    | to_entries
    | map(select(.value.source.source == "directory")
      | [.key, (.value.installLocation // .value.source.path)])
    | sort_by(.[1])[][]'
}

# Prints the path inside of the -v argument $1, source:target or
# source:target:ro.
mount_target() {
  local target=${1#*:}
  printf '%s\n' "${target%:ro}"
}

# Prints the path inside of each bind mount the compose files give the
# claude service. A named volume, such as the login's, holds none of the
# Mac's files, so it does not count. When docker compose config fails, a
# line names the result $1.
compose_bind_targets() {
  local config
  if ! config=$("${compose[@]}" config --format json 2>/dev/null); then
    echo "docker/cc: docker compose config failed, so $1" >&2
    return 0
  fi
  jq -r '.services.claude.volumes[]? | select(.type == "bind") | .target' <<<"$config"
}

# The image's managed settings hook Stop and Notification to drop each event
# as a file into /run/cc-notify. That is this session's own directory, and a
# loop on the host hands each file to notify_host. A file drop needs no port,
# so two sessions never collide.
#
# compose replaces this script, through exec, so every signal reaches
# compose directly. compose keeps this script's process ID. The loop checks
# that ID on each pass. When the process has ended, the loop removes the
# directory and stops.
# Sets notify_dir and notify_log, which watch_events reads.
start_notify_watcher() {
  notify_dir=$(mktemp -d "${TMPDIR:-/tmp}/cc-notify.XXXXXX")
  # The notifier's output. It sits outside the directory, so it outlasts the
  # session.
  notify_log=${TMPDIR:-/tmp}/cc-notify.log
  watch_events &
}

# Runs $1, claude or bash, inside with the other arguments. Before it starts:
# point agent-browser at the Mac's Chrome, recreate the links, run the repo's
# start_commands, then run docker/cc.local's setup.
run_container() {
  local program=$1
  shift
  local setup
  setup="$(browser_setup)${links}{ $start_commands; } && { $local_setup; }"
  exec "${compose[@]}" run --rm ${mounts[@]+"${mounts[@]}"} \
    -v "$notify_dir:/run/cc-notify" claude \
    bash -c "$setup && exec $program \"\$@\"" "$program" "$@"
}

# Prints the shell text that points agent-browser inside at the Mac's Chrome,
# ending in " && ", or nothing when agent_browser_port is empty.
#
# agent-browser drives the Chrome that the repo opens on the Mac with remote
# debugging on that port. Chrome refuses a request that names a host other
# than localhost or an IP, so connect by the IP that host.docker.internal
# resolves to. It is looked up inside, at start, because Docker Desktop can
# change it. It takes the IPv4 address, because an IPv6 one would need
# brackets in the URL. If the name does not resolve, it warns and leaves the
# variable unset. The variable overrides agent-browser.json.
browser_setup() {
  [ -n "$agent_browser_port" ] || return 0
  # shellcheck disable=SC2016 # expands inside the container, not here
  printf '%s' 'mac_ip=$(getent ahostsv4 host.docker.internal | awk "NR == 1 {print \$1}")
if [ -n "$mac_ip" ]; then export AGENT_BROWSER_CDP=http://$mac_ip:'"$agent_browser_port"'
else echo "docker/cc: host.docker.internal does not resolve, so agent-browser cannot reach the Mac'"'"'s Chrome" >&2; fi && '
}

# Runs on the host for each Stop and Notification event inside. Its stdin is
# the event's JSON, and its working directory is the session's directory.
# It runs in this terminal's environment, so a notifier that checks
# $TMUX_PANE sees your pane. docker/cc.local can redefine it.
notify_host() {
  if command -v cc-notify.mjs >/dev/null; then cc-notify.mjs; fi
}

# Every tenth pass, about every 5 seconds, the loop also runs
# block_git_pointers. A full search of the repo takes too long to run on
# every pass. finish_watch runs it once more when the loop ends. Sets
# blocked, the paths that block_git_pointers moved aside. The loop runs in
# its own process, so this does not reach the launcher.
watch_events() {
  local event cwd pass=0
  blocked=()
  # A hangup or TERM that reaches the loop still runs finish_watch.
  trap finish_watch EXIT
  trap exit HUP TERM
  while kill -0 $$ 2>/dev/null; do
    pass=$((pass + 1))
    if [ $((pass % 10)) -eq 0 ]; then
      block_git_pointers
    fi
    for event in "$notify_dir"/*.json; do
      [ -e "$event" ] || continue
      # The repo mounts at its own path, so a directory under it inside is
      # the same directory on the host. Any other path falls back to the
      # repo root. So does a path with an escaped character, because the sed
      # does not decode JSON.
      cwd=$(sed -n 's/.*"cwd" *: *"\([^"]*\)".*/\1/p' "$event" | head -n 1) ||
        cwd=
      # One event runs at a time, with no time limit. A notifier that hangs
      # holds back every later event of the session.
      # Claude owns the terminal, so the notifier writes to the log instead.
      (
        case $cwd in
          "$repo" | "$repo"/*) cd "$cwd" 2>/dev/null || cd "$repo" ;;
          *) cd "$repo" ;;
        esac
        notify_host
      ) <"$event" >>"${notify_log:-/dev/null}" 2>&1 || true
      rm -f "$event"
    done
    sleep 0.5
  done
}

# Runs the last block_git_pointers of the session, then names each path it
# moved aside during the session, and removes notify_dir. watch_events runs
# it on exit, so it also runs when a hangup or TERM ends the loop.
finish_watch() {
  block_git_pointers
  if [ ${#blocked[@]} -gt 0 ]; then
    echo "docker/cc: moved aside to .cc-blocked, since each could lead git on the Mac to hooks or a config written inside:" >&2
    printf '  %s\n' "${blocked[@]}" >&2
  fi
  rm -rf "$notify_dir"
}

# Moves aside each path that find_git_pointers prints, so git on the Mac
# stops reading it. The new name is <path>.cc-blocked. When that is taken, a
# number goes after it. A directory's HEAD moves aside too, or git would take
# the moved directory for a bare repo. Each move goes to notify_host as a
# Notification event. Each moved path goes into blocked.
block_git_pointers() {
  local path to
  while IFS= read -r path; do
    to=$path.cc-blocked
    if path_exists "$to"; then
      to=$to-$RANDOM$RANDOM
    fi
    mv "$path" "$to" 2>/dev/null || continue
    if [ -d "$to" ] && [ ! -L "$to" ] && path_exists "$to/HEAD"; then
      mv "$to/HEAD" "$to/HEAD.cc-blocked" 2>/dev/null || true
    fi
    blocked+=("$path")
    (cd "$repo" && notify_host) >>"${notify_log:-/dev/null}" 2>&1 <<EOF || true
{"hook_event_name":"Notification","cwd":"$(json_escape "$repo")","message":"docker/cc blocked $(json_escape "$path"): it could lead git on the Mac to hooks or a config written inside"}
EOF
  done < <(find_git_pointers)
}

# Prints $1 escaped for a JSON string. A path can hold a tab or a newline,
# and JSON takes neither as it is.
json_escape() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf '%s' "$s"
}


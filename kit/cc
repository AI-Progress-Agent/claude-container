#!/usr/bin/env bash
# The claude-container launcher's entry point. A repo does not call it
# directly: its docker/cc stub copies this kit out of the image and runs it.
# The launcher itself is the Python package in src/launcher, which says what
# it does.
#
# uv makes the kit's .venv on the first run, with the Python that
# .python-version names. It fetches that Python when the Mac has none. Then
# this runs that Python in place of itself. So one process runs from the stub
# to docker compose, as with the bash launcher before it, and none of uv's
# variables reach compose or docker/cc.local.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if ! command -v uv >/dev/null; then
  # shellcheck disable=SC2016 # the backticks are the message's own
  echo 'docker/cc: needs uv; run `brew install uv`' >&2
  exit 1
fi
# --inexact keeps the dev tools in a checkout's .venv, as KIT_DEV runs it.
# -E and -s keep a PYTHONPATH or a user's site-packages out of the launcher.
UV_PROJECT_ENVIRONMENT=$here/.venv uv sync --quiet --frozen --no-dev --inexact --project "$here"
exec "$here/.venv/bin/python" -E -s "$here/src" "$@"
